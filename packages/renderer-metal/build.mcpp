// macOS: embed the Metal shaders that scripts/dev/compile_shaders.py
// generates from src/renderer/metal/shaders/cgpui_metal.slang, one source per
// entry point in src/renderer/metal/generated/, as raw strings in
// metal_shaders_source.hpp; compile each with xcrun as a check that it
// builds (the .air files are not shipped). See metal_shaders in
// tools/mcpp/cgpui_build.cppm.
import cgpui.build;

int main() {
  if (!cgpui_build::target_is("macos")) {
    return 0;
  }
  // The functions metal_pipeline_library.mm creates, in its order.
  cgpui_build::metal_shaders(
      "src/renderer/metal/generated",
      {"cgpui_vertex", "cgpui_solid_fragment", "cgpui_rounded_fragment",
       "cgpui_glyph_fragment", "cgpui_image_fragment", "cgpui_box_shadow_vertex",
       "cgpui_box_shadow_fragment", "cgpui_backdrop_fragment"});
}
